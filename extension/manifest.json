{
  "manifest_version": 3,
  "name": "ytlrc bridge",
  "version": "0.1.0",
  "description": "Kirim lagu dan posisi playback YouTube ke daemon ytlrc di localhost.",
  "permissions": ["tabs"],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*", "*://music.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
